{
  "type": "object",
  "required": ["overview", "sections", "findings"],
  "properties": {
    "overview": {"type": "string", "maxLength": 1200},
    "sections": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "required": ["title", "files"],
      "properties": {"title": {"type": "string"}, "summary": {"type": "string"},
                     "files": {"type": "array", "items": {"type": "string"}}}}},
    "findings": {"type": "array", "maxItems": 40, "items": {
      "type": "object",
      "required": ["category", "severity", "file", "start_line", "end_line", "title", "explanation", "confidence", "anchor", "trigger"],
      "properties": {
        "category": {"enum": ["bug", "flag", "security"]},
        "severity": {"enum": ["severe", "non_severe", "investigate", "informational", "critical", "warning"]},
        "file": {"type": "string"}, "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "maxLength": 140},
        "explanation": {"type": "string", "maxLength": 2000},
        "trigger": {"type": "string", "description": "concrete input or sequence that shows the bug"},
        "suggested_fix": {"type": "string", "maxLength": 2000},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "anchor": {"type": "string", "description": "exact code line(s) the finding is about"},
        "introduced_by_pr": {"type": "boolean"},
        "evidence": {"type": "string", "description": "file:line citations proving the claim"},
        "instances": {"type": "array", "items": {"type": "string"}}}}},
    "prior": {"type": "array", "items": {
      "type": "object", "required": ["fingerprint", "status"],
      "properties": {"fingerprint": {"type": "string"},
                     "status": {"enum": ["fixed", "still_open", "obsolete"]},
                     "evidence": {"type": "string"}}}}
  }
}
